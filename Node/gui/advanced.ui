 padding:  2px;
}

QCheckBox {
	background: transparent;
   color: white;
}

QCheckBox::indicator { 
  background: rgb(255, 255, 255);
 color: #143a61;
 border: 2px solid #143a61;
 width:  14px; 
 height:  14px;
 border-radius:4px; 
}
QCheckBox::indicator:checked {
    image: url(:/resource/object-select-symbolic.symbolic.png);
}

QPushButton {
		background: rgba(249,253,255,60);
		border-radius: 4px;
	    color: #ffffff;
}

QPushButton:hover:pressed {
		background-color: #3297ca;
}

QPushButton:hover:!pressed {
        background-color: rgba(249,253,255,80);
}</string>
