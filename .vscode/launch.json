{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Staging Client (onmydisk)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Node/target/usr/bin/onmydisk",
            "args": [
                "-c",
                "/tmp/onmydisk-staging.conf",
                "/tmp/staging_share"
            ],
            "preLaunchTask": "Build Embedded Debug",
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Node/target/usr/bin",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/Node/target/usr/lib"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run Staging Client (onmydisk)",
