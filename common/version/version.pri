INCLUDEPATH	+= $$PWD
DEPENDPATH      += $$PWD

# Auto-detect P2P_ENABLED from environment if set
P2P_ENV = $$(P2P_ENABLED)
!isEmpty(P2P_ENV): DEFINES += P2P_ENABLED

# When building with P2P_ENABLED, product version is 3 (OMD 3.0)
contains(DEFINES, P2P_ENABLED)|contains(CONFIG, P2P_ENABLED) {
    isEmpty(PRODUCT_VERSION): PRODUCT_VERSION = 3
} else {
    isEmpty(PRODUCT_VERSION): PRODUCT_VERSION = 2
}
isEmpty(VERSION_MAJOR): VERSION_MAJOR = 1
isEmpty(VERSION_MINOR): VERSION_MINOR = 5

DEFINES -= PRODUCT_VERSION=2 PRODUCT_VERSION=3
DEFINES += PRODUCT_VERSION=$$PRODUCT_VERSION
DEFINES += VERSION_MAJOR=$$VERSION_MAJOR
DEFINES += VERSION_MINOR=$$VERSION_MINOR


# Allow override from a file (e.g. for CI)
VERSION_FILE_PATH = $$PWD/../../VERSION
exists($$VERSION_FILE_PATH) {
    REVISION = $$cat($$VERSION_FILE_PATH)
    # Force qmake to re-run if this file changes
    QMAKE_INTERNAL_INCLUDED_FILES += $$VERSION_FILE_PATH
}

isEmpty(REVISION) {
    contains(CONFIG, DEPLOY) {
        REVISION = $$BUILD_VERSION
        DEFINES += DEPLOY
        message("Deployment build")
    }else{
        REVISION =  $$system(git rev-list HEAD --count)
    }
}

APP_VERSION_STR = $$PRODUCT_VERSION"."$$VERSION_MAJOR"."$$VERSION_MINOR"."$$REVISION
APP_VERSION = $$APP_VERSION_STR

VERSION_FILE = $$OUT_PWD/build_version.h
VERSION_FILE_CONTENT = "/* Auto-generated by qmake */"
VERSION_FILE_CONTENT += "$${LITERAL_HASH}define APP_VERSION \"$$APP_VERSION_STR\""
VERSION_FILE_CONTENT += "$${LITERAL_HASH}define BUILD_NUMBER \"$$REVISION\""
write_file($$VERSION_FILE, VERSION_FILE_CONTENT)

INCLUDEPATH += $$OUT_PWD
HEADERS += $$VERSION_FILE

HEADERS  +=   $$PWD/version.h



