[General]
docRoot=/srv/www
IndexFiles="index.html,index.htm,default.htm,default.html,iisstart.htm"
SharedIndexFiles=shared.html
AutoIndex=true
SingleThread=false
iconDir=/srv/www/mimetypes
PID=/tmp/onmydisk.pid
smtphost=smtp.example.com
smtpport=587
smtplogin=noreply@example.com
smtppass=
smtpehlo=client

[Notifications]
Enabled=true
Port=9988
Secure=false

[Network]
port=9000
CA=/var/onmydisk/pki/rootCA.crt
Cert=/var/onmydisk/ssl/link.crt
pKey=/var/onmydisk/ssl/link.key
pKeyPass=onmydisk

[FileNode]
Enabled=true
Network=false
Localhost=false
Port=/var/run/onmydisk.sock
Secure=false


[PKI]
LinkCACert=/var/onmydisk/pki/rootCA.crt
CACert=/var/onmydisk/pki/rootCA.crt
CAKey=/var/onmydisk/pki/rootCA.key
CAPass='onmydisk_pki'


[templates]
cacheSize=1000000
cacheTime=60000
encoding=UTF-8
suffix=.html


[logging]
logFile=/var/logs/omd-server.log
minLevel=0
bufferSize=100
maxSize=1000000
maxBackups=2
timestampFormat=dd.MM.yyyy hh:mm:ss.zzz
msgFormat={timestamp} {typeNr} {type} {thread} {msg}



[AuthDB]
driver=QSQLITE
database=/srv/etc/config/onmydisk.db
